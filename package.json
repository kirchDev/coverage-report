{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "coverage-report",
  "version": "0.0.0",
  "description": "Self-hosted coverage reporting on pull requests — total, delta and patch coverage from the reports CI already produces, with no third-party platform.",
  "keywords": [
    "clover",
    "cobertura",
    "code-coverage",
    "coverage",
    "coverage-report",
    "github-action",
    "istanbul",
    "kirchdev",
    "lcov",
    "monorepo",
    "nodejs",
    "patch-coverage",
    "pest",
    "phpunit",
    "pull-request",
    "vitest"
  ],
  "homepage": "https://github.com/kirchDev/coverage-report#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/coverage-report/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/coverage-report.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.js",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "taze": "^19.16.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
