{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "coverage-report",
  "version": "0.1.0",
  "description": "Coverage reporting on pull requests, straight from the reports your CI already writes — no third-party service.",
  "keywords": [
    "clover",
    "cobertura",
    "code-coverage",
    "coverage",
    "coverage-report",
    "github-action",
    "istanbul",
    "kirchdev",
    "lcov",
    "monorepo",
    "nodejs",
    "patch-coverage",
    "pest",
    "phpunit",
    "pull-request",
    "vitest"
  ],
  "homepage": "https://github.com/kirchDev/coverage-report#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/coverage-report/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/coverage-report.git"
  },
  "bin": {
    "coverage-report": "./bin/coverage-report.js"
  },
  "files": [
    "action.yml",
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "pnpm lint && pnpm format && pnpm check:types && pnpm check:policy && pnpm check:dist && pnpm test",
    "check:dist": "node scripts/check-dist.js",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.js",
    "check:types": "tsc --noEmit",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "prepare": "husky",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "test": "node --test 'test/**/*.test.ts'",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout 'test/**/*.test.ts'",
    "test:watch": "node --test --watch 'test/**/*.test.ts'"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "taze": "^19.16.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
